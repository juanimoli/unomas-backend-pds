@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
left to right direction

' ===================== DTOs & Enums =====================
package "DTOs" {
  enum TipoEstrategia {
    NIVEL_HABILIDAD
    CERCANIA
    HISTORIAL
  }

  class UsuarioDTO {
    +nombre: String
    +email: String
    +nivelJuego: String
    +longitud: Double
    +latitud: Double
  }

  class PartidoDTO {
    +deporte: String
    +cantidadJugadores: Integer
    +fecha: Date
    +hora: Time
    +duracionMin: Integer
    +ubicacion: String
  }

  class BusquedaDTO {
    +tipoEstrategia: TipoEstrategia
    +deporte: String
    +fecha: String
  }
}

' ===================== MVC =====================
package "Patrón MVC" {
  class PartidoMatcherController {
    +matcherService: MatcherService
    +unirseAPartido(user: UsuarioDTO, partido: PartidoDTO): void
    +confirmarPartido(partido: PartidoDTO): PartidoDTO
  }

  class UsuarioController {
    +usuarioService: UsuarioService
    +crearUsuario(UsuarioDTO): UsuarioDTO
    +obtenerUsuario(int): UsuarioDTO
    +actualizarUsuario(UsuarioDTO): UsuarioDTO
  }

  class PartidoController {
    +partidoService: PartidoService
    +crearPartido(partido: PartidoDTO): PartidoDTO
    +buscarPartidos(busqueda: BusquedaDTO): List<Partido>
    +cancelarPartido(partido: PartidoDTO)
  }

  class MatcherService {
    +usuarioService: UsuarioService
    +partidoService: PartidoService
    +unirseAPartido(int, int)
    +confirmarPartido(int, int)
  }

  class UsuarioService {
    -usuarioRepository: UsuarioRepository
    +registrarUsuario(): Usuario
    +obtenerUsuario(): Usuario
    +actualizarUsuario(): Usuario
    +crearUsuario(Usuario): Usuario
  }

  class PartidoService {
    -emparejamiento: EmparejamientoStrategyFactory
    -partidoRepository: PartidoRepository
    +crearPartido(partido: Partido): Partido
    +buscarPartido(tipoEstrategia: TipoEstrategia, deporte: String): List<Partido>
    +cancelarPartido(id: Integer)
  }

  interface UsuarioRepository {
    +findByEmail(email: String): Usuario
  }

  interface PartidoRepository {
    +findByEstadoActual(estado: EstadoPartido): List<Partido>
    +findByDeporte(deporte: String): List<Partido>
  }

  PartidoMatcherController --> MatcherService
  UsuarioController --> UsuarioService
  PartidoController --> PartidoService
  MatcherService --> UsuarioService
  MatcherService --> PartidoService
  UsuarioService --> UsuarioRepository
  PartidoService --> PartidoRepository
}

' ===================== Dominio =====================
package "Dominio" {
  enum NivelJuego {
    PRINCIPIANTE
    INTERMEDIO
    AVANZADO
  }

  class Ubicacion {
    +longitud: Double
    +latitud: Double
  }

  class Usuario {
    +id: Integer
    +nombre: String
    +email: String
    +nivelJuego: NivelJuego
    +partidos: List<Partido>
    +ubicacion: Ubicacion
    +unirseAPartido(partido: Partido)
    +bajarseDePartido(partido: Partido)
  }

  class Partido {
    +id: Integer
    +tipoDeporte: String
    +organizador: Usuario
    +jugadores: List<Usuario>
    +estado: EstadoPartido
    +cantidadJugadores: Integer
    +duracionPartidoMin: Integer
    +fechaPartido: Date
    +hora: Time
    +observers: List<IListener>
    +ubicacion: Ubicacion
    +agregarObserver(listener: IListener)
    +eliminarObserver(listener: IListener)
    +notificarObservadores(mensaje: String)
  }

  Usuario "0..*" -- "0..*" Partido : participa
  Partido "1" -- "1" Usuario : organizador
  Usuario "1" -- "1" Ubicacion
  Partido "1" -- "1" Ubicacion
}

' ===================== Strategy (Emparejamiento) =====================
package "Patrón Strategy (Emparejamiento)" {
  interface EmparejamientoStrategy {
    +esCompatible(usuario: Usuario, partido: Partido)
    +calcularCompatibilidadUsuario(usuario: Usuario, partido: Partido)
  }

  class CercaniaStrategy {
    +esCompatible(usuario: Usuario, partido: Partido)
    +calcularCompatibilidadUsuario(usuario: Usuario, partido: Partido)
  }
  class NivelHabilidadStrategy {
    +esCompatible(usuario: Usuario, partido: Partido)
    +calcularCompatibilidadUsuario(usuario: Usuario, partido: Partido)
  }
  class HistorialStrategy {
    +esCompatible(usuario: Usuario, partido: Partido)
    +calcularCompatibilidadUsuario(usuario: Usuario, partido: Partido)
  }

  EmparejamientoStrategy <|.. CercaniaStrategy
  EmparejamientoStrategy <|.. NivelHabilidadStrategy
  EmparejamientoStrategy <|.. HistorialStrategy

  class EmparejamientoStrategyFactory {
    +crearEstrategia(tipo: TipoEstrategia): EmparejamientoStrategy
  }

  EmparejamientoStrategyFactory ..> EmparejamientoStrategy : crearEstrategia()
  PartidoService --> EmparejamientoStrategyFactory
  BusquedaDTO --> TipoEstrategia
}

' ===================== State =====================
package "Patrón State" {
  interface EstadoPartido {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }

  class BuscandoJugadores {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }
  class PartidoArmado {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }
  class Confirmado {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }
  class EnJuego {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }
  class Cancelado {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }
  class Finalizado {
    +equipoCompleto(partido: Partido)
    +confirmar(partido: Partido)
    +iniciar(partido: Partido)
    +finalizar(partido: Partido)
    +cancelar(partido: Partido)
  }

  EstadoPartido <|.. BuscandoJugadores
  EstadoPartido <|.. PartidoArmado
  EstadoPartido <|.. Confirmado
  EstadoPartido <|.. EnJuego
  EstadoPartido <|.. Cancelado
  EstadoPartido <|.. Finalizado

  Partido --> EstadoPartido : estado
}

' ===================== Observable/Observer + Strategy(Notif) + Adapter =====================
package "Patrón Observable/Observer" {
  interface IObservable {
    +agregarObserver(): void
    +eliminarObserver(): void
    +notificarObservadores(mensaje: String): void
  }

  interface IListener {
    +notificar(observable: Object)
  }

  class PartidoListener {
    -estrategia: IStrategiaNotificacion
    +notificar(observable: Object)
  }

  Partido ..|> IObservable
  PartidoListener ..|> IListener
  Partido "0..*" --> IListener : observers
}

package "Patrón Strategy (Notificación)" {
  interface IStrategiaNotificacion {
    +notificar(mensaje: NotificationDTO)
  }

  class EmailNotificationObserver {
    +notificar(mensaje: NotificationDTO)
  }
  class PushNotificationObserver {
    +notificar(mensaje: NotificationDTO)
  }

  IStrategiaNotificacion <|.. EmailNotificationObserver
  IStrategiaNotificacion <|.. PushNotificationObserver

  class NotificationDTO {
    +atributos: Map<String, String>
  }

  PartidoListener --> IStrategiaNotificacion : utiliza
  IStrategiaNotificacion --> NotificationDTO
}

package "Patrón Adapter" {
  interface EmailSenderAdapter {
    +send(subject: String, body: String)
  }
  class JavaMailAdapter {
    +send(subject: String, body: String)
  }
  EmailSenderAdapter <|.. JavaMailAdapter

  interface PushNotificationAdapter {
    +sendNotification(userID: Integer, message: String)
  }
  class FirebaseAdapter {
    +sendNotification(userID: Integer, message: String)
  }
  PushNotificationAdapter <|.. FirebaseAdapter

  EmailNotificationObserver --> EmailSenderAdapter : utiliza 1
  PushNotificationObserver --> PushNotificationAdapter : utiliza 1
}
@enduml
