@startuml UnoMas_DiagramaCasosDeUso

title Sistema Uno Mas - Diagrama de Casos de Uso

left to right direction

actor "Usuario" as User
actor "Organizador" as Org
actor "Jugador" as Player
actor "Sistema\n(Scheduler)" as System

rectangle "Sistema Uno Mas" {
  
  package "Gestión de Usuarios" {
    usecase "Registrarse" as UC1
    usecase "Actualizar Perfil" as UC2
    usecase "Ver Perfil" as UC3
    usecase "Configurar\nNotificaciones" as UC4
  }
  
  package "Gestión de Partidos" {
    usecase "Crear Partido" as UC5
    usecase "Buscar Partidos" as UC6
    usecase "Ver Detalle\ndel Partido" as UC7
    usecase "Unirse a Partido" as UC8
    usecase "Confirmar Partido" as UC9
    usecase "Iniciar Partido" as UC10
    usecase "Finalizar Partido" as UC11
    usecase "Cancelar Partido" as UC12
  }
  
  package "Emparejamiento" {
    usecase "Filtrar por\nNivel de Habilidad" as UC13
    usecase "Filtrar por\nCercanía" as UC14
    usecase "Filtrar por\nHistorial" as UC15
    usecase "Verificar\nCompatibilidad" as UC16
  }
  
  package "Notificaciones" {
    usecase "Recibir Notificación\nde Nuevo Partido" as UC17
    usecase "Recibir Notificación\nde Equipo Completo" as UC18
    usecase "Recibir Notificación\nde Confirmación" as UC19
    usecase "Recibir Notificación\nde Inicio" as UC20
    usecase "Recibir Notificación\nde Cancelación" as UC21
  }
  
  package "Procesos Automáticos" {
    usecase "Cambiar Estado\nautomáticamente" as UC22
    usecase "Iniciar Partidos\nProgramados" as UC23
  }
}

' Relaciones Usuario General
User <|-- Org
User <|-- Player

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC6
User --> UC7

' Relaciones Organizador
Org --> UC5 : <<crea>>
Org --> UC9 : <<confirma>>
Org --> UC10 : <<inicia>>
Org --> UC11 : <<finaliza>>
Org --> UC12 : <<cancela>>

' Relaciones Jugador
Player --> UC8 : <<se une>>

' Relaciones de Búsqueda
UC6 ..> UC13 : <<include>>
UC6 ..> UC14 : <<include>>
UC6 ..> UC15 : <<include>>
UC8 ..> UC16 : <<include>>

' Relaciones de Notificaciones
UC5 ..> UC17 : <<trigger>>
UC8 ..> UC18 : <<trigger>>
UC9 ..> UC19 : <<trigger>>
UC10 ..> UC20 : <<trigger>>
UC12 ..> UC21 : <<trigger>>

' Usuario recibe notificaciones
User --> UC17 : <<recibe>>
User --> UC18 : <<recibe>>
User --> UC19 : <<recibe>>
User --> UC20 : <<recibe>>
User --> UC21 : <<recibe>>

' Relaciones Sistema
System --> UC22 : <<ejecuta>>
System --> UC23 : <<ejecuta>>

UC8 ..> UC22 : <<trigger>>
UC23 ..> UC10 : <<ejecuta>>

note right of UC5
  <b>Factory Pattern</b>
  PartidoFactory crea
  diferentes tipos de partidos
end note

note right of UC13
  <b>Strategy Pattern</b>
  NivelHabilidadStrategy
  evalúa compatibilidad
end note

note right of UC14
  <b>Strategy Pattern</b>
  CercaniaStrategy
  calcula distancias
end note

note right of UC15
  <b>Strategy Pattern</b>
  HistorialStrategy
  analiza partidos previos
end note

note right of UC22
  <b>State Pattern</b>
  EstadoPartido gestiona
  transiciones automáticas
end note

note right of UC17
  <b>Observer + Adapter Pattern</b>
  NotificacionObserver +
  EmailAdapter/FirebaseAdapter
end note

note top of System
  <b>PartidoSchedulerService</b>
  Verifica cada minuto si hay
  partidos confirmados cuya
  fecha/hora ha llegado
end note

legend right
  <b>Actores:</b>
  • <b>Usuario:</b> Usuario registrado en el sistema
  • <b>Organizador:</b> Usuario que crea partidos
  • <b>Jugador:</b> Usuario que se une a partidos
  • <b>Sistema:</b> Procesos automáticos
  
  <b>Relaciones:</b>
  • ——→ Asociación (actor participa en caso de uso)
  • · · · → Include (caso de uso incluye otro)
  • ——▷ Herencia (especialización de actor)
  
  <b>Patrones aplicados:</b>
  • Strategy: Emparejamiento de jugadores
  • State: Transiciones de estado automáticas
  • Observer: Sistema de notificaciones
  • Adapter: Servicios de notificación
  • Factory: Creación de partidos
endlegend

@enduml
